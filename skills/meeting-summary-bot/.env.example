# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real tokens.

# --- Required ---
ANTHROPIC_API_KEY=            # Anthropic Console API key (usage is billed to the key owner)
SLACK_BOT_TOKEN=              # xoxb-...  (OAuth & Permissions > Bot User OAuth Token)
SLACK_APP_TOKEN=              # xapp-...  (Basic Information > App-Level Tokens, scope connections:write)

# --- Optional (defaults shown) ---
SUMMARY_MODEL=claude-sonnet-5-5
SUMMARY_EFFORT=medium         # low | medium | high | xhigh | max
SUMMARY_FALLBACK=default      # server-side refusal fallback; "off" to disable
ALLOWED_USER_IDS=             # comma-separated Slack user IDs; empty = everyone in the workspace
ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs for @mentions; empty = any channel (DMs unaffected)
MAX_CONCURRENT_JOBS=2
MAX_FILE_MB=20
MAX_TOTAL_MB=20
LOG_LEVEL=INFO
